PORT=5000
NODE_ENV=development

# PostgreSQL Connection URL
# Example: postgresql://postgres:your_password@localhost:5432/researchflow
DATABASE_URL=

# Fallback Individual parameters (if not using DATABASE_URL):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=researchflow
PGSSL=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=demo-researchflow
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=researchflow_secure_jwt_token_key_2026_super_secret
